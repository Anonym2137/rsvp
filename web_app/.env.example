# RSVP web app — example environment variables.
# Copy to `.env` and adjust as needed. This file is NOT committed (it is force-included by .gitignore).

# Path to the SQLite database file (relative to the web_app working directory).
DATABASE_URL=./db.sqlite

# Optional: path to a Chromium/Chrome binary used for headless EPUB analysis.
# Leave empty to use the bundled/auto-detected browser. Example: /usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=
